# Your domain – point its DNS A/AAAA record at the VPS before starting.
DOMAIN=chat.example.com

# Code needed to create the workspace on a fresh server (keeps strangers from claiming it).
# Leave unset to have one generated on first start – it is printed in the logs: docker compose logs relay | grep setup
# SETUP_TOKEN=

# Max upload size per file in MB
MAX_UPLOAD_MB=100

# Fetch link previews (title/description/image) for URLs posted in messages
UNFURL_LINKS=true

# Huddles (calls): STUN works for most networks. For strict NATs enable the coturn
# service (docker compose --profile turn up -d) and fill these in:
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:chat.example.com:3478
# TURN_USERNAME=relay
# TURN_PASSWORD=change-me-to-something-long

# Extra origins allowed to call the API (desktop/mobile apps during development)
# CORS_ORIGINS=http://localhost:5173

# Optional: bridge channels with an existing Slack workspace (see README – "Slack bridge")
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# AI agents. Usually set up in Workspace settings → AI agents; these variables override the UI.
# Provider: anthropic (default) | openai | gemini | openrouter | mistral | ollama | custom
# AI_PROVIDER=anthropic
# API key of the provider you use:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# MISTRAL_API_KEY=...
# AI_API_KEY=...            # custom OpenAI-compatible endpoint (optional)
# Base URL for ollama / custom (or to route another OpenAI-compatible provider through a proxy):
# AI_BASE_URL=http://host.docker.internal:11434/v1
# Workspace default model (for providers other than Anthropic, an id from the provider's model list):
# AI_MODEL=claude-opus-5-5
